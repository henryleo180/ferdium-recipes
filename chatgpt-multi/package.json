{
  "name": "chatgpt-multi",
  "productName": "ChatGPT Multi",
  "version": "1.0.0",
  "private": true,
  "description": "多账号 ChatGPT 桌面小软件：每个标签独立登录一个账号，可分屏同时使用",
  "license": "MIT",
  "author": "henryleo180",
  "homepage": "https://github.com/henryleo180/ferdium-recipes",
  "desktopName": "chatgpt-multi.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test test/e2e/app.e2e.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "io.github.henryleo180.chatgpt-multi",
    "productName": "ChatGPT Multi",
    "publish": null,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChatGPT 的语音输入需要使用麦克风。"
      }
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "syncDesktopName": true,
      "maintainer": "henryleo180"
    }
  }
}
